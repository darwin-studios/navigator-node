{
  "name": "@darwinso/navigator",
  "version": "0.5.0",
  "description": "Official Navigator TypeScript SDK by Darwin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darwin-studios/navigator-node.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./openai": {
      "import": {
        "types": "./openai.d.mts",
        "default": "./openai.mjs"
      },
      "require": {
        "types": "./openai.d.cts",
        "default": "./openai.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.mjs",
    "*.cjs",
    "*.mts",
    "*.cts",
    "README.md",
    "LICENSE",
    "generated"
  ],
  "dependencies": {
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=20.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
