{
  "name": "@darwinso/sdk",
  "version": "0.5.0",
  "description": "Official TypeScript SDK for Darwin",
  "keywords": [
    "darwin",
    "agent",
    "sdk"
  ],
  "homepage": "https://darwin.so/docs/surfaces/api",
  "bugs": {
    "url": "https://github.com/darwin-studios/darwin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darwin-studios/navigator-node.git"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./generated/esm/index.d.mts",
      "import": "./generated/esm/index.mjs",
      "require": "./generated/cjs/index.js"
    },
    "./package.json": "./package.json",
    "./openai": {
      "import": {
        "types": "./generated/esm/openai/index.d.mts",
        "default": "./generated/esm/openai/index.mjs"
      },
      "require": {
        "types": "./generated/cjs/openai/index.d.ts",
        "default": "./generated/cjs/openai/index.js"
      }
    }
  },
  "main": "./generated/cjs/index.js",
  "module": "./generated/esm/index.mjs",
  "types": "./generated/esm/index.d.mts",
  "files": [
    "generated",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/verify-generated.mjs && node scripts/build-transport.mjs --check && node scripts/build-openai.mjs --check",
    "build:openai": "node scripts/build-openai.mjs",
    "build:transport": "node scripts/build-transport.mjs",
    "check-types": "tsc --noEmit --strict --skipLibCheck --module NodeNext --target ES2022 test/thread-types.mts src/transport/make-request.ts",
    "test": "node scripts/verify-generated.mjs && node scripts/build-transport.mjs --check && node scripts/build-openai.mjs --check && pnpm check-types && node --test test/*.test.mjs"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "prettier": "3.8.2",
    "typescript": "5.9.2",
    "@types/node": "25.9.1"
  },
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=20.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
